# ==============================================================================
# Intizomly — Supabase Environment Variables Template
# Ushbu fayldan nusxa olib, ".env.local" nomli yangi fayl yarating va o'z kalitlaringizni kiriting.
# Diqqat: Haqiqiy maxfiy kalitlarni (secret key) hech qachon bu yerga yoki git-ga yuklamang!
# ==============================================================================

# Supabase Project URL (Supabase Dashboard -> Project Settings -> API -> Project URL)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anon Key (Supabase Dashboard -> Project Settings -> API -> anon public key)
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key-here
